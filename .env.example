POSTGRES_USER=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JUPYTERHUB_ADMIN=
SERVER_IP=
OPENAI_API_KEY_TH=

# IBM DB2 -- valores genéricos (fallback). Para credenciales propias de un
# proyecto, agrega variables con sufijo en vez de reusar estas, ej.
# DB2_USER_TH / DB2_PASSWORD_TH (mismo patrón que OPENAI_API_KEY_TH arriba) --
# cualquier nombre que empiece con DB2_ llega solo a JupyterHub/Prefect, no
# hace falta tocar jupyterhub_config.py ni docker-compose.yml de nuevo.
DB2_HOST=
DB2_PORT_SAAC=
DB2_PORT_SAF=
DB2_PORT_DAGO=
DB2_DATABASE_SAAC=
DB2_DATABASE_SAF=
DB2_DATABASE_DAGO=
DB2_USER=
DB2_PASSWORD=
