# Copia este archivo a dashboards/<proyecto>/.streamlit/secrets.toml
# (NUNCA lo subas a git -- ya está en .gitignore) para activar el login
# con Microsoft Entra ID en este proyecto. Mientras este archivo no
# exista, el botón "Iniciar sesión con Microsoft" simplemente no aparece
# y el dashboard sigue funcionando solo con usuario/contraseña.
#
# Ver STREAMLIT_GUIDE.md, sección "Login con Microsoft Entra ID", para el
# paso a paso de qué crear en Azure Portal y de dónde sale cada valor.

[auth]
# http://SERVER_IP/<proyecto>/oauth2callback (o https://<proyecto>.midominio.com/oauth2callback
# cuando exista dominio -- ver STREAMLIT_GUIDE.md). Debe coincidir EXACTO
# con un Redirect URI registrado en Azure Portal para esta app.
redirect_uri = "http://SERVER_IP/NOMBRE_PROYECTO/oauth2callback"

# Clave aleatoria única de este proyecto para firmar la cookie de sesión
# de Streamlit (no confundir con cookie.key de config.yaml, son cosas
# distintas). Generar con:
# python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CLAVE_ALEATORIA_UNICA"

# "Application (client) ID" de la app registrada en Azure Portal
# (Entra ID > App registrations > tu app > Overview).
client_id = "PEGAR_APPLICATION_CLIENT_ID"

# Certificates & secrets > New client secret > columna "Value"
# (se muestra una sola vez al crearlo, cópialo antes de salir de esa pantalla).
client_secret = "PEGAR_CLIENT_SECRET_VALUE"

# Reemplaza TENANT_ID por el "Directory (tenant) ID" de Overview.
server_metadata_url = "https://login.microsoftonline.com/TENANT_ID/v2.0/.well-known/openid-configuration"
